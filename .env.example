# Supabase connection string. Copy the URI from Supabase Connect > ORMs.
# Use the session pooler URI for long-lived web requests, with sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Alternatively, omit DATABASE_URL and set all five separate variables.
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=YOUR_PASSWORD

# Cloud Synchronization Security Token (Matches the token configured on offline POS terminals)
SYNC_TOKEN=procast_sync_key

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pos_System

# ── Platform Super Admin ──────────────────────────────────────────────────
# Set APP_ENV=production AND ENABLE_SUPER_ADMIN=true ONLY on Render/cloud.
# On local XAMPP leave both unset (or false) — the admin portal returns HTTP 404.
APP_ENV=local
ENABLE_SUPER_ADMIN=false

# 32-byte random key for AES-256-GCM encryption of TOTP secrets.
# Generate: php -r "echo base64_encode(random_bytes(32));"
PLATFORM_CRYPTO_KEY=

# Where PHP stores super-admin sessions (must be writable, outside web root).
PLATFORM_SESSION_PATH=/tmp/procast_super_sess

# Timezone for daily/monthly transaction volume aggregation.
PLATFORM_TIMEZONE=Asia/Manila

# Used by seed script only — never stored in DB as plaintext.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=
