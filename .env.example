# Supabase connection string. Copy the URI from Supabase Connect > ORMs.
# Use the session pooler URI for long-lived web requests, with sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Alternatively, omit DATABASE_URL and set all five separate variables.
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=YOUR_PASSWORD

# Cloud Synchronization Security Token (Must match the token configured on every
# offline POS terminal).
#
# REQUIRED, and deliberately EMPTY. This file is committed, so any value written
# here is public knowledge -- and anyone who has read this repository could then
# push a whole fabricated catalogue into every till's mirror. An empty value, an
# unfilled placeholder (PASTE_YOUR / REPLACE_WITH / ...) and anything under 32
# characters are all REFUSED at runtime rather than silently accepted, so leaving
# this blank fails closed instead of syncing with a shared public secret.
# Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SYNC_TOKEN=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pos_System

# ── Platform Super Admin ──────────────────────────────────────────────────
# Set APP_ENV=production AND ENABLE_SUPER_ADMIN=true ONLY on Render/cloud.
# On local XAMPP leave both unset (or false) — the admin portal returns HTTP 404.
APP_ENV=local
ENABLE_SUPER_ADMIN=false

# 32-byte random key for AES-256-GCM encryption of TOTP secrets.
# Generate: php -r "echo base64_encode(random_bytes(32));"
PLATFORM_CRYPTO_KEY=

# Where PHP stores super-admin sessions (must be writable, outside web root).
PLATFORM_SESSION_PATH=/tmp/procast_super_sess

# Timezone for daily/monthly transaction volume aggregation.
PLATFORM_TIMEZONE=Asia/Manila

# Used by the seed script only — never stored in DB as plaintext.
# Leave the password EMPTY: it is refused at runtime unless it is at least 12
# characters and is not a published placeholder, because this file is committed
# and this account is exempt from the brute-force lockout.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Administrator
