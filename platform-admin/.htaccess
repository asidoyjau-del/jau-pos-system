# ProCast Platform Super Admin — clean URLs.
# EVERY request under /platform-admin/ (pages, assets, views/, migrations/, any
# file) is routed through index.php. index.php enforces the environment fence
# and answers a bare 404 when the module is disabled, so no admin file is ever
# served directly by Apache.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # index.php itself: serve as-is (also prevents a rewrite loop)
    RewriteRule ^index\.php$ - [L]
    # everything else -> front controller
    RewriteRule ^ index.php [L]
</IfModule>
